    "@capacitor/network": "7.0.2",
    "@supabase/supabase-js": "2.118.0",
    "epubjs": "0.3.93",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.10",
    "esbuild": "0.25.12"
  },
